<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: #1e1e1e; color: #d4d4d4; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

    /* Top Bar */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #252526;
      padding: 8px 14px;
      border-bottom: 1px solid #3c3c3c;
    }

    /* Menu Dropdown */
    .menu-container { position: relative; display: inline-block; }
    .menu-btn {
      background-color: #333333;
      color: #ffffff;
      border: 1px solid #454545;
      padding: 6px 12px;
      font-size: 14px;
      border-radius: 4px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .menu-btn:hover { background-color: #444444; }

    .dropdown-content {
      display: none;
      position: absolute;
      left: 0;
      top: 110%;
      background-color: #2d2d30;
      min-width: 175px;
      box-shadow: 0px 8px 16px rgba(0,0,0,0.6);
      border: 1px solid #454545;
      border-radius: 4px;
      z-index: 100;
    }
    .dropdown-content button {
      color: #e0e0e0;
      padding: 10px 14px;
      display: block;
      width: 100%;
      text-align: left;
      background: none;
      border: none;
      font-size: 14px;
      cursor: pointer;
    }
    .dropdown-content button:hover { background-color: #094771; color: #ffffff; }
    .show { display: block; }

    .file-info { font-size: 13px; color: #9cdcfe; margin-left: 12px; font-weight: 500; }

    /* Main Screen Action Buttons (Run & Reset Only) */
    .action-buttons { display: flex; gap: 8px; align-items: center; }
    .btn-run {
      background-color: #28a745;
      color: white;
      border: none;
      padding: 6px 14px;
      font-size: 14px;
      font-weight: bold;
      border-radius: 4px;
      cursor: pointer;
    }
    .btn-run:hover { background-color: #218838; }
    .btn-run:disabled { background-color: #555555; cursor: not-allowed; }

    .btn-reset {
      background-color: #444444;
      color: #e0e0e0;
      border: 1px solid #5a5a5a;
      padding: 6px 12px;
      font-size: 14px;
      border-radius: 4px;
      cursor: pointer;
    }
    .btn-reset:hover { background-color: #c82333; color: white; border-color: #bd2130; }

    /* Workspace */
    .editor-container { flex: 1; display: flex; flex-direction: column; padding: 8px; gap: 8px; overflow: hidden; }
    textarea {
      width: 100%;
      background-color: #1e1e1e;
      color: #d4d4d4;
      border: 1px solid #3c3c3c;
      border-radius: 4px;
      padding: 10px;
      font-family: 'Consolas', 'Courier New', monospace;
      font-size: 15px;
      resize: none;
      outline: none;
    }
    textarea:focus { border-color: #007acc; }
    #codeEditor { flex: 3; line-height: 1.5; tab-size: 4; }

    /* Input & Output Area */
    .io-section { flex: 1.6; display: flex; gap: 8px; min-height: 120px; }
    .io-box { flex: 1; display: flex; flex-direction: column; }
    .io-label { font-size: 12px; color: #aaaaaa; margin-bottom: 4px; font-weight: 600; }
    #userInput, #consoleOutput { flex: 1; font-size: 14px; background-color: #252526; }
    #consoleOutput { color: #ce9178; }

    /* Responsive layout for mobile phones */
    @media (max-width: 600px) {
      .io-section { flex-direction: column; flex: 2; }
    }

    /* Popup Modals */
    .modal {
      display: none;
      position: fixed;
      z-index: 200;
      left: 0; top: 0;
      width: 100%; height: 100%;
      background-color: rgba(0,0,0,0.65);
      justify-content: center;
      align-items: center;
    }
    .modal-content {
      background-color: #252526;
      padding: 20px;
      border: 1px solid #454545;
      border-radius: 6px;
      width: 90%;
      max-width: 400px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }
    .modal-content h3 { margin-bottom: 12px; font-size: 16px; color: #ffffff; }
    .modal-content input {
      width: 100%; padding: 8px 10px; margin-bottom: 14px;
      background: #1e1e1e; border: 1px solid #454545; color: white; border-radius: 4px; font-size: 14px;
    }
    .modal-footer { display: flex; justify-content: flex-end; gap: 8px; }
    .file-list { max-height: 200px; overflow-y: auto; margin-bottom: 14px; border: 1px solid #3c3c3c; border-radius: 4px; }
    .file-item { padding: 9px 12px; cursor: pointer; border-bottom: 1px solid #333; font-size: 14px; }
    .file-item:hover { background-color: #094771; color: white; }
  </style>
</head>
<body>

  <!-- Top Navigation Bar -->
  <div class="navbar">
    <div style="display: flex; align-items: center;">
      <div class="menu-container">
        <button class="menu-btn" onclick="toggleMenu()">☰ Menu</button>
        <div id="fileMenu" class="dropdown-content">
          <button onclick="newFile()">📄 New File</button>
          <button onclick="openFileModal()">📂 Open File</button>
          <button onclick="saveFileModal()">💾 Save File</button>
        </div>
      </div>
      <span id="currentFileName" class="file-info">Main.java</span>
    </div>

    <!-- Main Screen Buttons: Run & Reset -->
    <div class="action-buttons">
      <button id="runBtn" class="btn-run" onclick="runCode()">▶ Run</button>
      <button class="btn-reset" onclick="resetEditor()">↺ Reset</button>
    </div>
  </div>

  <!-- Editor and I/O Area -->
  <div class="editor-container">
    <textarea id="codeEditor" spellcheck="false">public class Main {
    public static void main(String[] args) {
        System.out.println("Hello, Java!");
    }
}</textarea>

    <div class="io-section">
      <div class="io-box">
        <span class="io-label">Standard Input (Scanner):</span>
        <textarea id="userInput" placeholder="Enter inputs here (separated by space or new line)..."></textarea>
      </div>
      <div class="io-box">
        <span class="io-label">Console Output:</span>
        <textarea id="consoleOutput" readonly placeholder="Output will appear here..."></textarea>
      </div>
    </div>
  </div>

  <!-- Save File Modal -->
  <div id="saveModal" class="modal">
    <div class="modal-content">
      <h3>Save Java File</h3>
      <input type="text" id="saveFileNameInput" placeholder="Enter file name (e.g., PrimeCheck.java)">
      <div class="modal-footer">
        <button class="btn-reset" onclick="closeModals()">Cancel</button>
        <button class="btn-run" onclick="confirmSaveFile()">Save</button>
      </div>
    </div>
  </div>

  <!-- Open File Modal -->
  <div id="openModal" class="modal">
    <div class="modal-content">
      <h3>Open Saved File</h3>
      <div id="savedFilesList" class="file-list"></div>
      <div class="modal-footer">
        <button class="btn-reset" onclick="closeModals()">Close</button>
      </div>
    </div>
  </div>

  <script>
    // আপনার Apps Script Web App URL নিচে বসান
    const SCRIPT_URL = "আপনার_APPS_SCRIPT_WEB_APP_URL_এখানে_বসান";

    const defaultTemplate = `public class Main {\n    public static void main(String[] args) {\n        System.out.println("Hello, Java!");\n    }\n}`;

    // Tab key সাপোর্ট যুক্ত করা হলো যাতে কোড লেখার সময় Tab চাপলে পরের ফিল্ডে চলে না যায়
    document.getElementById("codeEditor").addEventListener("keydown", function(e) {
      if (e.key === "Tab") {
        e.preventDefault();
        const start = this.selectionStart;
        const end = this.selectionEnd;
        this.value = this.value.substring(0, start) + "    " + this.value.substring(end);
        this.selectionStart = this.selectionEnd = start + 4;
      }
    });

    // Menu Toggle
    function toggleMenu() {
      document.getElementById("fileMenu").classList.toggle("show");
    }

    window.onclick = function(event) {
      if (!event.target.matches('.menu-btn')) {
        const dropdowns = document.getElementsByClassName("dropdown-content");
        for (let i = 0; i < dropdowns.length; i++) {
          if (dropdowns[i].classList.contains('show')) {
            dropdowns[i].classList.remove('show');
          }
        }
      }
    };

    // Common Backend Fetch Function
    async function callBackend(payload) {
      const response = await fetch(SCRIPT_URL, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify(payload)
      });
      return await response.json();
    }

    // 1. Run Java Code
    async function runCode() {
      const runBtn = document.getElementById("runBtn");
      const outputBox = document.getElementById("consoleOutput");
      const code = document.getElementById("codeEditor").value;
      const input = document.getElementById("userInput").value;

      if (!code.trim()) {
        outputBox.value = "Editor is empty!";
        return;
      }

      runBtn.disabled = true;
      runBtn.innerText = "Running...";
      outputBox.value = "Compiling and executing on server...";

      try {
        const res = await callBackend({ action: "compile", code: code, input: input });
        if (res.status === "success") {
          outputBox.value = res.output;
        } else {
          outputBox.value = "Error: " + res.message;
        }
      } catch (err) {
        outputBox.value = "Network Error: Could not reach the compiler server.";
      } finally {
        runBtn.disabled = false;
        runBtn.innerText = "▶ Run";
      }
    }

    // 2. Reset Editor
    function resetEditor() {
      if (confirm("Reset editor to default code? Unsaved changes will be cleared.")) {
        document.getElementById("codeEditor").value = defaultTemplate;
        document.getElementById("userInput").value = "";
        document.getElementById("consoleOutput").value = "";
        document.getElementById("currentFileName").innerText = "Main.java";
      }
    }

    // 3. New File
    function newFile() {
      resetEditor();
    }

    // 4. Save File Modal & Action
    function saveFileModal() {
      document.getElementById("saveFileNameInput").value = document.getElementById("currentFileName").innerText;
      document.getElementById("saveModal").style.display = "flex";
    }

    async function confirmSaveFile() {
      let fileName = document.getElementById("saveFileNameInput").value.trim();
      const code = document.getElementById("codeEditor").value;
      
      if (!fileName) {
        alert("Please enter a valid file name.");
        return;
      }
      if (!fileName.endsWith(".java")) {
        fileName += ".java";
      }

      closeModals();
      const outputBox = document.getElementById("consoleOutput");
      outputBox.value = "Saving " + fileName + " to Drive...";

      try {
        const res = await callBackend({ action: "save", fileName: fileName, code: code });
        if (res.status === "success") {
          document.getElementById("currentFileName").innerText = fileName;
          outputBox.value = res.message;
        } else {
          outputBox.value = "Save Error: " + res.message;
        }
      } catch (err) {
        outputBox.value = "Error saving file.";
      }
    }

    // 5. Open File Modal & Action
    async function openFileModal() {
      document.getElementById("openModal").style.display = "flex";
      const listDiv = document.getElementById("savedFilesList");
      listDiv.innerHTML = "<div style='padding:12px; color:#aaaaaa;'>Loading saved files...</div>";

      try {
        const res = await callBackend({ action: "listFiles" });
        if (res.status === "success" && res.files.length > 0) {
          listDiv.innerHTML = "";
          res.files.forEach(file => {
            const item = document.createElement("div");
            item.className = "file-item";
            item.innerText = "📄 " + file.name;
            item.onclick = () => loadFileContent(file.id, file.name);
            listDiv.appendChild(item);
          });
        } else {
          listDiv.innerHTML = "<div style='padding:12px; color:#aaaaaa;'>No saved files found in Drive.</div>";
        }
      } catch (err) {
        listDiv.innerHTML = "<div style='padding:12px; color:#f48771;'>Failed to load file list.</div>";
      }
    }

    async function loadFileContent(fileId, fileName) {
      closeModals();
      const outputBox = document.getElementById("consoleOutput");
      outputBox.value = "Opening " + fileName + "...";

      try {
        const res = await callBackend({ action: "loadFile", fileId: fileId });
        if (res.status === "success") {
          document.getElementById("codeEditor").value = res.code;
          document.getElementById("currentFileName").innerText = fileName;
          outputBox.value = "Loaded: " + fileName;
        } else {
          outputBox.value = "Error loading file: " + res.message;
        }
      } catch (err) {
        outputBox.value = "Network error while loading file.";
      }
    }

    function closeModals() {
      document.getElementById("saveModal").style.display = "none";
      document.getElementById("openModal").style.display = "none";
    }
  </script>
</body>
</html>
